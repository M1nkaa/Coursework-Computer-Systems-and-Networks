<Window x:Class="RPS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RPS.Client.ViewModels"
        Title="🎮 Камень Ножницы Бумага - Клиент" 
        Height="720" Width="920"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== ЗАГОЛОВОК ========== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎮 Камень Ножницы Бумага" 
                              Style="{StaticResource Headline5}"
                              Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                              Style="{StaticResource Body2}"
                              Opacity="0.7"/>
                </StackPanel>

                <Border Grid.Column="1" 
                       Background="{StaticResource PrimaryColor}"
                       CornerRadius="20"
                       Padding="12,6"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerName}" 
                                  FontWeight="SemiBold"
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚪 Выйти из игры"
                           Command="{Binding LeaveGameCommand}"
                           Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}"
                           Height="38"
                           Padding="15,0"
                           Margin="0,0,8,0"
                           Background="#F57C00"/>

                    <Button Content="🔌 Подключиться"
                           Command="{Binding ConnectCommand}"
                           Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVis}}"
                           Height="38"
                           Padding="15,0"/>

                    <Button Content="❌ Отключиться"
                           Command="{Binding DisconnectCommand}"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                           Height="38"
                           Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== ПАНЕЛЬ ПОДКЛЮЧЕНИЯ ========== -->
        <Border Grid.Row="1" 
                Style="{StaticResource Card}" 
                Margin="0,0,0,12"
                Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Настройки подключения" 
                          Style="{StaticResource Headline6}"
                          Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="👤 Ваше имя" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🌐 IP сервера" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ServerIP, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="🔌 Порт" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========== ЛОББИ ========== -->
        <Grid Grid.Row="2" Visibility="{Binding ShowLobby, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🎮 Доступные игры" Style="{StaticResource Headline6}" VerticalAlignment="Center"/>
                        <Button Content="🔄 Обновить"
                               Command="{Binding RefreshGamesCommand}"
                               Margin="12,0,0,0"
                               Padding="12,6"
                               FontSize="12"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" 
                            ItemsSource="{Binding AvailableGames}"
                            SelectedItem="{Binding SelectedGame}"
                            Background="Transparent"
                            BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackground}" 
                                       CornerRadius="5" 
                                       Padding="12" 
                                       Margin="0,4">
                                    <TextBlock Text="{Binding DisplayName}" 
                                              Style="{StaticResource Body1}"
                                              FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Действия" Style="{StaticResource Headline6}" Margin="0,0,0,15"/>

                    <Button Content="➕ Создать новую игру"
                           Command="{Binding CreateGameCommand}"
                           Height="50"
                           Margin="0,0,0,12"/>

                    <Button Content="🚪 Присоединиться"
                           Command="{Binding JoinGameCommand}"
                           Height="50"
                           Background="#4CAF50"/>

                    <TextBlock Text="💡 Совет" 
                              Style="{StaticResource Headline6}" 
                              Margin="0,25,0,8"/>
                    <TextBlock Text="Создайте свою игру или выберите существующую из списка и нажмите 'Присоединиться'."
                              TextWrapping="Wrap"
                              Opacity="0.7"
                              FontSize="12"
                              LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== ИГРОВАЯ ОБЛАСТЬ ========== -->
        <Grid Grid.Row="2" Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ТАБЛО СЧЁТА (скрывается во время анимации) -->
            <Border Grid.Row="0" 
                    Style="{StaticResource Card}" 
                    Margin="0,0,0,10" 
                    Padding="15"
                    Visibility="{Binding HideScoreboard, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" 
                                  Style="{StaticResource Headline6}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PlayerScore}" 
                                  FontSize="40"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource PrimaryColor}"/>
                        <TextBlock Text="ВЫ" 
                                  HorizontalAlignment="Center"
                                  Opacity="0.6"
                                  FontSize="11"
                                  Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" 
                           Background="{StaticResource PrimaryColor}"
                           CornerRadius="25"
                           Padding="20,12"
                           Margin="30,0">
                        <TextBlock Text="VS" 
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OpponentName}" 
                                  Style="{StaticResource Headline6}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding OpponentScore}" 
                                  FontSize="40"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource SecondaryColor}"/>
                        <TextBlock Text="СОПЕРНИК" 
                                  HorizontalAlignment="Center"
                                  Opacity="0.6"
                                  FontSize="11"
                                  Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- АНИМАЦИЯ БИТВЫ -->
            <Border Grid.Row="0" 
        Background="{StaticResource CardBackground}"
        CornerRadius="12"
        Margin="0,0,0,10" 
        Padding="30,20"
        x:Name="AnimationBorder"
        Visibility="{Binding ShowAnimation, Converter={StaticResource BoolToVis}}"
        IsVisibleChanged="AnimationBorder_IsVisibleChanged">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая рука (ВЫ) -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" 
                      FontSize="18"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,15"/>

                        <Viewbox Width="100" Height="100">
                            <TextBlock Text="{Binding LeftPlayerEmoji}" x:Name="LeftHand">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LeftHandTransform" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Viewbox>
                    </StackPanel>

                    <!-- Центр -->
                    <TextBlock Grid.Column="1" 
                  Text="⚔️" 
                  FontSize="40"
                  Margin="40,0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>

                    <!-- Правая рука (СОПЕРНИК) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OpponentName}" 
                      FontSize="18"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,15"/>

                        <Viewbox Width="100" Height="100">
                            <TextBlock Text="{Binding RightPlayerEmoji}" x:Name="RightHand">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="RightHandTransform" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- РЕЗУЛЬТАТ РАУНДА -->
            <Border Grid.Row="1" 
                    Style="{StaticResource Card}" 
                    Margin="0,0,0,10"
                    Padding="20,15"
                    Visibility="{Binding ShowAnimation, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding ResultMessage}" 
                          FontSize="18"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          Foreground="{Binding ResultColor}"
                          LineHeight="24"/>
            </Border>

            <!-- КНОПКИ ВЫБОРА -->
            <Grid Grid.Row="2">
                <UniformGrid Columns="3" Rows="1" Margin="15,0">

                    <Button Command="{Binding RockCommand}" 
                            Margin="8" 
                            Height="160"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="🪨" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Камень" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PaperCommand}" 
                            Margin="8" 
                            Height="160"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="📄" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Бумага" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ScissorsCommand}" 
                            Margin="8" 
                            Height="160"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="✂️" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Ножницы" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </Grid>

        </Grid>

        <!-- ========== ОКНО ЗАВЕРШЕНИЯ ИГРЫ ========== -->
        <Border Grid.Row="2" 
                Style="{StaticResource Card}"
                Visibility="{Binding ShowGameEndScreen, Converter={StaticResource BoolToVis}}"
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="600"
                MaxHeight="500">
            <StackPanel>
                <TextBlock Text="🏁 Игра завершена!" 
                          FontSize="32"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,25"/>

                <Border Background="{StaticResource CardBackground}" 
                       CornerRadius="12" 
                       Padding="30,20"
                       Margin="0,0,0,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayerName}" 
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding PlayerScore}" 
                                      FontSize="42"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource PrimaryColor}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                  Text="—" 
                                  FontSize="36"
                                  FontWeight="Bold"
                                  Margin="30,0"
                                  VerticalAlignment="Center"
                                  Opacity="0.5"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OpponentName}" 
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding OpponentScore}" 
                                      FontSize="42"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      Foreground="{StaticResource SecondaryColor}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding GameEndMessage}" 
                          FontSize="15"
                          HorizontalAlignment="Center"
                          TextAlignment="Center"
                          Margin="0,0,0,30"
                          Opacity="0.85"
                          LineHeight="22"
                          TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                           Content="🎮 Создать новую игру"
                           Command="{Binding CreateNewGameAfterEndCommand}"
                           Height="55"
                           Background="#4CAF50"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                    <Button Grid.Column="2"
                           Content="🚪 Выйти в лобби"
                           Command="{Binding ExitToLobbyCommand}"
                           Height="55"
                           Background="#F44336"
                           FontSize="13"
                           FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>