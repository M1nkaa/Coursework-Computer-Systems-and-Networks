<Window x:Class="RPS.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RPS.Client.ViewModels"
        Title="🎮 Камень Ножницы Бумага — Клиент" 
        Height="760" Width="940"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== ЗАГОЛОВОК ========== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎮 Камень Ножницы Бумага" 
                              Style="{StaticResource Headline5}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                              Style="{StaticResource Body2}" Opacity="0.7"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource PrimaryColor}"
                       CornerRadius="20" Padding="12,6" Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayerName}" 
                                  FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚪 Выйти из игры"
                           Command="{Binding LeaveGameCommand}"
                           Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}"
                           Height="38" Padding="15,0" Margin="0,0,8,0" Background="#F57C00"/>
                    <Button Content="🔌 Подключиться"
                           Command="{Binding ConnectCommand}"
                           Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVis}}"
                           Height="38" Padding="15,0"/>
                    <Button Content="❌ Отключиться"
                           Command="{Binding DisconnectCommand}"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                           Height="38" Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== ПАНЕЛЬ ПОДКЛЮЧЕНИЯ ========== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"
                Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Настройки подключения" Style="{StaticResource Headline6}" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="👤 Ваше имя" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🌐 IP сервера" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ServerIP, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="🔌 Порт" Style="{StaticResource Body2}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========== ЛОББИ ========== -->
        <Grid Grid.Row="2" Visibility="{Binding ShowLobby, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🎮 Доступные игры" Style="{StaticResource Headline6}" VerticalAlignment="Center"/>
                        <Button Content="🔄 Обновить" Command="{Binding RefreshGamesCommand}"
                               Margin="12,0,0,0" Padding="12,6" FontSize="12"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" 
                            ItemsSource="{Binding AvailableGames}"
                            SelectedItem="{Binding SelectedGame}"
                            Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackground}"
                                       CornerRadius="5" Padding="12" Margin="0,4">
                                    <TextBlock Text="{Binding DisplayName}"
                                              Style="{StaticResource Body1}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Действия" Style="{StaticResource Headline6}" Margin="0,0,0,15"/>

                    <!-- Выбор режима -->
                    <TextBlock Text="🎯 Режим игры" Style="{StaticResource Body2}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                        <StackPanel>
                            <RadioButton Content="∞  Бесконечный" 
                                        IsChecked="{Binding IsInfiniteMode}"
                                        FontSize="13" Margin="0,0,0,8"
                                        Foreground="White"/>
                            <RadioButton Content="🏆  Первый до 5 побед"
                                        IsChecked="{Binding IsFirstTo5Mode}"
                                        FontSize="13"
                                        Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Button Content="➕ Создать новую игру"
                           Command="{Binding CreateGameCommand}"
                           Height="50" Margin="0,0,0,12"/>

                    <Button Content="🚪 Присоединиться"
                           Command="{Binding JoinGameCommand}"
                           Height="50" Background="#4CAF50"/>

                    <TextBlock Text="💡 Совет" Style="{StaticResource Headline6}" Margin="0,25,0,8"/>
                    <TextBlock Text="Создайте свою игру (выбрав режим) или выберите существующую из списка и нажмите «Присоединиться»."
                              TextWrapping="Wrap" Opacity="0.7" FontSize="12" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== ИГРОВАЯ ОБЛАСТЬ ========== -->
        <Grid Grid.Row="2" Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ТАБЛО СЧЁТА -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="15"
                    Visibility="{Binding HideScoreboard, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" Style="{StaticResource Headline6}"
                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayerScore}" FontSize="40" FontWeight="Bold"
                                      HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                            <TextBlock Text="{Binding ScoreGoalLabel}" FontSize="20" FontWeight="Normal"
                                      VerticalAlignment="Bottom" Margin="4,0,0,6" Opacity="0.5"/>
                        </StackPanel>
                        <TextBlock Text="ВЫ" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryColor}" CornerRadius="25"
                               Padding="20,12" Margin="30,0,30,5">
                            <TextBlock Text="VS" FontSize="20" FontWeight="Bold" Foreground="White"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <!-- Метка режима игры -->
                        <TextBlock Text="{Binding GameModeLabel}" FontSize="11" Opacity="0.6"
                                  HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OpponentName}" Style="{StaticResource Headline6}"
                                  HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OpponentScore}" FontSize="40" FontWeight="Bold"
                                      HorizontalAlignment="Center" Foreground="{StaticResource SecondaryColor}"/>
                            <TextBlock Text="{Binding ScoreGoalLabel}" FontSize="20" FontWeight="Normal"
                                      VerticalAlignment="Bottom" Margin="4,0,0,6" Opacity="0.5"/>
                        </StackPanel>
                        <TextBlock Text="СОПЕРНИК" HorizontalAlignment="Center" Opacity="0.6" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- АНИМАЦИЯ БИТВЫ -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackground}" CornerRadius="12"
                    Margin="0,0,0,8" Padding="30,20"
                    x:Name="AnimationBorder"
                    Visibility="{Binding ShowAnimation, Converter={StaticResource BoolToVis}}"
                    IsVisibleChanged="AnimationBorder_IsVisibleChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlayerName}" FontSize="18" FontWeight="Bold"
                                  HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <Viewbox Width="100" Height="100">
                            <TextBlock Text="{Binding LeftPlayerEmoji}" x:Name="LeftHand">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="LeftHandTransform" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Viewbox>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="⚔️" FontSize="40"
                              Margin="40,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding OpponentName}" FontSize="18" FontWeight="Bold"
                                  HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <Viewbox Width="100" Height="100">
                            <TextBlock Text="{Binding RightPlayerEmoji}" x:Name="RightHand">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="RightHandTransform" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Viewbox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ТАЙМЕР AFK -->
            <Border Grid.Row="1" 
                    Visibility="{Binding ShowAfkTimer, Converter={StaticResource BoolToVis}}"
                    Background="#B71C1C" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️ До AFK-кика: " FontSize="15" FontWeight="Bold"
                              Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AfkTimerSeconds, StringFormat='{}{0} сек'}"
                              FontSize="18" FontWeight="Bold" Foreground="#FFCDD2"
                              VerticalAlignment="Center"/>
                    <TextBlock Text=" — сделайте ход!" FontSize="13" Foreground="White"
                              Opacity="0.8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- РЕЗУЛЬТАТ РАУНДА -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="20,15"
                    Visibility="{Binding ShowAnimation, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding ResultMessage}" FontSize="17" FontWeight="SemiBold"
                          HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                          Foreground="{Binding ResultColor}" LineHeight="24"/>
            </Border>

            <!-- КНОПКИ ВЫБОРА -->
            <Grid Grid.Row="3">
                <UniformGrid Columns="3" Rows="1" Margin="15,0">

                    <Button Command="{Binding RockCommand}" Margin="8" Height="155"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="🤜" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Камень" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ScissorsCommand}" Margin="8" Height="155"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="✌️" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Ножницы" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PaperCommand}" Margin="8" Height="155"
                            IsEnabled="{Binding CanMakeChoice}">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                        </Button.Effect>
                        <StackPanel>
                            <TextBlock Text="✋" FontSize="70" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Бумага" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </Grid>

        </Grid>

        <!-- ========== ОКНО ЗАВЕРШЕНИЯ ИГРЫ ========== -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Visibility="{Binding ShowGameEndScreen, Converter={StaticResource BoolToVis}}"
                Padding="25,20" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="600" MaxHeight="560">
            <StackPanel>
                <TextBlock Text="🏁 Игра завершена!" FontSize="26" FontWeight="Bold"
                          HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Счёт -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="10"
                       Padding="20,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayerName}" FontSize="15" FontWeight="SemiBold"
                                      HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PlayerScore}" FontSize="38" FontWeight="Bold"
                                      HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="—" FontSize="30" FontWeight="Bold"
                                  Margin="20,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OpponentName}" FontSize="15" FontWeight="SemiBold"
                                      HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding OpponentScore}" FontSize="38" FontWeight="Bold"
                                      HorizontalAlignment="Center" Foreground="{StaticResource SecondaryColor}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Сообщение -->
                <TextBlock Text="{Binding GameEndMessage}" FontSize="13"
                          HorizontalAlignment="Center" TextAlignment="Center"
                          Margin="0,0,0,14" Opacity="0.85" LineHeight="20" TextWrapping="Wrap"/>

                <!-- Выбор режима для новой игры (для всех) -->
                <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="10,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding ShowExitOnlyButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Режим новой игры:" FontSize="11" Opacity="0.6" Margin="0,0,0,6"
                                  HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton Content="∞ Бесконечный" IsChecked="{Binding IsInfiniteMode}"
                                        FontSize="12" Margin="0,0,18,0" Foreground="White"/>
                            <RadioButton Content="🏆 До 5 побед" IsChecked="{Binding IsFirstTo5Mode}"
                                        FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кнопки -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки для режима FirstTo5 — реванш -->
                    <Button Grid.Column="0"
                           Content="{Binding RematchButtonText}"
                           Command="{Binding RematchCommand}"
                           IsEnabled="{Binding CanClickRematch}"
                           Visibility="{Binding ShowRematchButton, Converter={StaticResource BoolToVis}}"
                           Height="46" Background="#4CAF50" FontSize="13" FontWeight="SemiBold"/>

                    <!-- Кнопки для обычного режима — новая игра -->
                    <Button Grid.Column="0"
                           Content="🎮 Новая игра"
                           Command="{Binding CreateNewGameAfterEndCommand}"
                           Visibility="{Binding ShowExitOnlyButton, Converter={StaticResource BoolToVis}}"
                           Height="46" Background="#4CAF50" FontSize="13" FontWeight="SemiBold"/>

                    <Button Grid.Column="2"
                           Content="🚪 Выйти в лобби"
                           Command="{Binding ExitToLobbyCommand}"
                           Height="46" Background="#F44336" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
