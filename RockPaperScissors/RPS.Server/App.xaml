<Application x:Class="RPS.Server.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ЦВЕТА -->
            <SolidColorBrush x:Key="PrimaryColor" Color="#3F51B5"/>
            <SolidColorBrush x:Key="SecondaryColor" Color="#00BCD4"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="CardBackground" Color="#2D2D30"/>
            <SolidColorBrush x:Key="TextColor" Color="White"/>

            <!-- СТИЛИ -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
                <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            </Style>

            <!-- Карточки -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопки -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#5C6BC0"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#303F9F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Поля ввода -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="15,12"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Текст -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Стили для заголовков -->
            <Style x:Key="Headline4" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="Headline5" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="Headline6" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="Body1" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>