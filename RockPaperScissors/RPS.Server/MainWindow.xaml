<Window x:Class="RPS.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎮 Сервер - Камень Ножницы Бумага" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🎮 Игровой сервер" 
                              Style="{StaticResource Headline4}"
                              Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText" 
                              Text="Сервер остановлен"
                              Style="{StaticResource Body1}"
                              Foreground="{StaticResource SecondaryColor}"/>
                </StackPanel>

                <!-- Кнопка запуска/остановки -->
                <Button x:Name="StartStopButton"
                       Grid.Column="1"
                       Content="▶️ ЗАПУСТИТЬ"
                       Click="StartStopButton_Click"
                       Width="180"
                       Height="50"/>
            </Grid>
        </Border>

        <!-- СТАТИСТИКА -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <UniformGrid Rows="1" Columns="4">

                <!-- Всего подключений -->
                <StackPanel Margin="10">
                    <TextBlock Text="👥 Игроков онлайн" 
                              Style="{StaticResource Body1}"
                              HorizontalAlignment="Center"
                              Opacity="0.7"/>
                    <TextBlock x:Name="PlayersOnlineText" 
                              Text="0"
                              Style="{StaticResource Headline4}"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource PrimaryColor}"/>
                </StackPanel>

                <!-- Активных игр -->
                <StackPanel Margin="10">
                    <TextBlock Text="🎲 Активных игр" 
                              Style="{StaticResource Body1}"
                              HorizontalAlignment="Center"
                              Opacity="0.7"/>
                    <TextBlock x:Name="ActiveGamesText" 
                              Text="0"
                              Style="{StaticResource Headline4}"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource SecondaryColor}"/>
                </StackPanel>

                <!-- В очереди -->
                <StackPanel Margin="10">
                    <TextBlock Text="⏳ В очереди" 
                              Style="{StaticResource Body1}"
                              HorizontalAlignment="Center"
                              Opacity="0.7"/>
                    <TextBlock x:Name="WaitingPlayersText" 
                              Text="0"
                              Style="{StaticResource Headline4}"
                              HorizontalAlignment="Center"
                              Foreground="#FFA726"/>
                </StackPanel>

                <!-- Всего игр -->
                <StackPanel Margin="10">
                    <TextBlock Text="📊 Всего игр" 
                              Style="{StaticResource Body1}"
                              HorizontalAlignment="Center"
                              Opacity="0.7"/>
                    <TextBlock x:Name="TotalGamesText" 
                              Text="0"
                              Style="{StaticResource Headline4}"
                              HorizontalAlignment="Center"
                              Foreground="#66BB6A"/>
                </StackPanel>

            </UniformGrid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- СПИСОК ИГРОКОВ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                              Text="👥 Подключенные игроки"
                              Style="{StaticResource Headline6}"
                              Padding="0,0,0,15"/>

                    <ListView x:Name="PlayersListView" Grid.Row="1" 
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,10,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PlayerName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" 
                                              Text="{Binding Score, StringFormat='🏆 {0}'}"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource SecondaryColor}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ЖУРНАЛ СОБЫТИЙ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="📋 Журнал событий" Style="{StaticResource Headline6}"/>

                        <Button Content="🗑️ Очистить"
                               Click="ClearLog_Click"
                               HorizontalAlignment="Right"
                               Padding="10,5"
                               FontSize="12"
                               Background="#F44336"/>
                    </Grid>

                    <ScrollViewer x:Name="LogScrollViewer" 
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBlock" 
                                  TextWrapping="Wrap"
                                  FontFamily="Consolas"
                                  FontSize="12"
                                  LineHeight="18"/>
                    </ScrollViewer>

                    <!-- Порт сервера -->
                    <Border Grid.Row="2" Background="{StaticResource CardBackground}" Padding="15,10" CornerRadius="5" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 Порт сервера:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="PortTextBox" Text="5000" Width="80" VerticalAlignment="Center" Padding="5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>